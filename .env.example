# Окружение API-сервера. Скопируйте в `.env` и заполните — `.env` не попадает в git.

# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://flower_stock:flower_stock@127.0.0.1:5432/flower_stock

# Порт API
PORT=5000

# Адрес, с которого открыт интерфейс. Cookie сессии отправляется с учётными данными,
# поэтому здесь должен быть настоящий адрес, а не шаблон.
APP_ORIGIN=http://127.0.0.1:22284

# В бою, когда TLS завершает nginx. Без этого `req.ip` — адрес прокси, и защита от
# подбора пароля считает всех пользователей одним ключом.
# TRUSTED_PROXY=loopback

# Первый администратор: создаётся при запуске, если такого пользователя ещё нет.
# Без этих переменных в свежей установке некому войти.
AUTH_ROOT_USERNAME=admin
AUTH_ROOT_PASSWORD=change-me-2026
AUTH_ROOT_DISPLAY_NAME=Администратор
# Поставьте 1 на один перезапуск, чтобы вернуть пароль выше существующему аккаунту.
# AUTH_ROOT_RESET_PASSWORD=1

# Провайдер AI для ассистента: любой OpenAI-совместимый.
# Он необязателен — без него склад работает, но ассистент и распознавание накладных
# отвечают «AI-провайдер не настроен». Модель обязана уметь вызывать инструменты.
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=
# OPENAI_MODEL=deepseek-flash

# Боты включаются явно: до появления публичного адреса с HTTPS они бесполезны.
BOTS_ENABLED=0

# Telegram: токен из @BotFather.
# TELEGRAM_BOT_TOKEN=

# MAX: токен из кабинета бизнеса. botapi.max.ru — тот же API, что и
# platform-api2.max.ru, но reachable без корневого сертификата Минцифры.
# MAX_BOT_TOKEN=
# MAX_API_BASE=https://botapi.max.ru
